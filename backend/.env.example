ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/eduquiz
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_NAME=eduquiz_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=24
REMEMBER_SESSION_TTL_DAYS=30
TERMS_VERSION=2026-06-24
PUBLIC_APP_URL=http://localhost:3000
EMAIL_LOGO_URL=https://reviss.app/assets/logos/Reviss_logo_dark.svg
REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_REDIS_REQUIRED=false

RECAPTCHA_SECRET_KEY=<recaptcha_secret_key>
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTENT_REPORT_RATE_LIMIT_WINDOW_SECONDS=600
CONTENT_REPORT_RATE_LIMIT_MAX_REQUESTS=5
CONTENT_REPORT_STORAGE_DIR=storage/content-reports
CONTENT_REPORT_ATTACHMENT_MAX_FILES=5
CONTENT_REPORT_ATTACHMENT_MAX_MB=10


RESEND_API_KEY=<resend_api_key>
RESEND_FROM_EMAIL="Reviss <noreply@reviss.app>"

STRIPE_SECRET_KEY=<stripe_secret_key>
STRIPE_WEBHOOK_SECRET=<stripe_webhook_secret>
STRIPE_API_BASE_URL=https://api.stripe.com/v1
STRIPE_CHECKOUT_SUCCESS_PATH=/upgrade?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_PATH=/upgrade?checkout=cancelled

PROJECT_STORAGE_DIR=storage/projects
PROJECT_UPLOAD_MAX_MB=100

OPENAI_API_KEY=<openai_api_key>
OPENAI_STUDY_MODEL=gpt-5.6-luna
OPENAI_QUIZ_MODEL=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_SECONDS=180
OPENAI_MAX_INPUT_CHARS=1000000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_ECHO=false
